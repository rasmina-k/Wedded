<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="help_ticket_portal_layout" name="Portal Layout: Help Ticket"
              inherit_id="portal.portal_breadcrumbs" priority="66">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'help_ticket'" class="breadcrumb-item active">
                <span>Help Tickets</span>
            </li>
            <li t-if="page_name == 'help_ticket_details'" class="breadcrumb-item active">
                <a t-attf-href="/help_ticket" aria-label="Home">
                    <span>Help Tickets</span>
                </a>
                <span>/
                    <t t-out="ticket.name"/>
                </span>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_help_ticket" name="Help Ticket"
              inherit_id="portal.portal_my_home" priority="65">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Help Tickets</t>
                <t t-set="url" t-value="'/help_ticket'"/>
                <t t-set="text">View and manage your help tickets</t>
                <t t-set="placeholder_count" t-value="'help_ticket_request_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Help Ticket List Template -->
    <template id="cloud_help_tickets_template" name="Help Ticket List">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Help Tickets</t>
            </t>
            <div class="row mb-4">
                <div class="col-md-12">
                    <ul class="nav nav-tabs" id="helpTicketTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#all">All</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#in_progress">In Progress
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#solved">Solved</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#verified">Verified</button>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="all">
                    <t t-if="help_ticket_request_count == 0">
                        <p class="text-center text-muted mt-4">No records found.</p>
                    </t>
                    <t t-else="">
                        <table class="table mt16 mb40">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Ticket ID</th>
                                    <th>Status</th>
                                    <th>Created On</th>
                                    <th>Assigned to</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="help_tickets" t-as="ticket">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/help_ticket/details/{{ ticket.id }}">
                                                <t t-out="ticket.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <t t-out="ticket.id"/>
                                        </td>
                                        <td>
                                            <span class="badge text-bg-info">
                                                <t t-out="ticket.state"/>
                                            </span>
                                        </td>
                                        <td>
                                            <t t-out="ticket.create_date"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.user_id.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
                <!-- In Progress Tickets Tab -->
                <div class="tab-pane fade" id="in_progress">
                    <t t-if="in_progress_tickets_count == 0">
                        <p class="text-center text-muted mt-4">No records found.</p>
                    </t>
                    <t t-else="">
                        <table class="table table-striped mt-3 mb-4">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Ticket ID</th>
                                    <th>Status</th>
                                    <th>Created On</th>
                                    <th>Assigned to</th>

                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="in_progress_tickets" t-as="ticket">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/help_ticket/details/{{ ticket.id }}">
                                                <t t-out="ticket.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <t t-out="ticket.id"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.state"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.create_date"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.user_id.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>

                <!-- Solved Tickets Tab -->
                <div class="tab-pane fade" id="solved">
                    <t t-if="solved_tickets_count == 0">
                        <p class="text-center text-muted mt-4">No records found.</p>
                    </t>
                    <t t-else="">
                        <table class="table table-striped mt-3 mb-4">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Ticket ID</th>
                                    <th>Status</th>
                                    <th>Created On</th>
                                    <th>Assigned To</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="solved_tickets" t-as="ticket">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/help_ticket/details/{{ ticket.id }}">
                                                <t t-out="ticket.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <t t-out="ticket.id"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.state"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.create_date"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.user_id.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>

                <!-- Verified Tickets Tab -->
                <div class="tab-pane fade" id="verified">
                    <t t-if="verified_tickets_count == 0">
                        <p class="text-center text-muted mt-4">No records found.</p>
                    </t>
                    <t t-else="">
                        <table class="table table-striped mt-3 mb-4">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Ticket ID</th>
                                    <th>Status</th>
                                    <th>Created On</th>
                                    <th>Assigned To</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="verified_tickets" t-as="ticket">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/help_ticket/details/{{ ticket.id }}">
                                                <t t-out="ticket.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <t t-out="ticket.id"/>
                                        </td>
                                        <td>
                                            <span class="badge text-bg-info">
                                                <t t-out="ticket.state"/>
                                            </span>
                                        </td>
                                        <td>
                                            <t t-out="ticket.create_date"/>
                                        </td>
                                        <td>
                                            <t t-out="ticket.user_id.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Help Ticket Details View -->
    <template id="cloud_help_ticket_details" name="Help Ticket Content"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/web#return_label=Website&amp;model=help.ticket&amp;id=%s&amp;' % ticket.id"/>
                </t>
            </t>
            <div class="row o_portal_sale_sidebar cy-help-ticket-details">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar" id="cloud_ticket_portal_sidebar">
                    <t t-set="classes" t-value="'d-print-none col-lg-3 col-xl-4'"/>

                    <t t-set="title">
                        <h5 class="cy-ticket-title">Ticket History</h5>
                    </t>

                    <div t-if="ticket.user_id">
                        <h6 class="cy-ticket-subtitle">
                            <small class="text-muted">Your Contact</small>
                        </h6>
                        <div class="o_portal_contact_details d-flex flex-column gap-2">
                            <div class="d-flex justify-content-start align-items-center gap-2">
                                <img class="o_avatar o_portal_contact_img rounded"
                                     t-att-src="image_data_uri(ticket.user_id.avatar_128)" alt="Contact"/>
                                <div>
                                    <h6 class="mb-0 cy-contact-name" t-out="ticket.user_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <hr class="cy-divider"/>
                <!--====== Adding Chatter==========-->
                <div id="help_ticket_communication" class="cy-help-communication">
                    <h3 class="cy-communication-title">Communication History</h3>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="ticket"/>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>