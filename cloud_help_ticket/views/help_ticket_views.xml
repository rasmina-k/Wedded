    <record id="cloud_help_ticket_action" model="ir.actions.act_window">
        <field name="name">Cloud Help Ticket</field>
        <field name="res_model">help.ticket</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_all': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Help tickets Entries
            </p>
            <p>
                Track and Create Help Ticket
            </p>
        </field>
    </record>

