<?xml version="1.0"?>
<odoo>
    <!--help ticket.tag views-->
    <record id="cloud_help_ticket_tag_view_form" model="ir.ui.view">
        <field name="name">cloud.help.ticket.tag.view.form</field>
        <field name="model">helpticket.tags</field>
        <field name="arch" type="xml">
            <form string="Help Ticket Tags">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Services"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" required="True" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cloud_help_ticket_tag_view_tree" model="ir.ui.view">
        <field name="name">cloud.help.ticket.tag.view.tree</field>
        <field name="model">helpticket.tags</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom" sample="1">
                <field name="name"/>
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <!-- Tags Configuration -->
    <record id="cloud_help_ticket_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpticket.tags</field>
        <field name="view_id" ref="cloud_help_ticket_tag_view_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create Help Ticket Tags.
            </p><p>
            Use Tags to manage and track your Opportunities.
            </p>
        </field>
    </record>
</odoo>
